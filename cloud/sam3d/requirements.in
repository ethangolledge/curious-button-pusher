# What the container runs, and nothing else: SAM 3D Objects' and SAM 3D Body's inference code
# needs these (found by reading their imports), at the versions their authors tested
# (sam-3d-objects requirements*.txt). Training, notebooks, web demos and experiment trackers
# are left out. `requirements.lock` is compiled from this file with a hash for every package:
#
#   uv pip compile requirements.in -o requirements.lock --generate-hashes \
#     --python-version 3.11 --python-platform x86_64-manylinux_2_28 \
#     --index-url https://pypi.org/simple --extra-index-url https://download.pytorch.org/whl/cu121 \
#     --find-links https://nvidia-kaolin.s3.us-east-2.amazonaws.com/torch-2.5.1_cu121.html \
#     --index-strategy unsafe-best-match --emit-index-url --emit-find-links
#
# The four packages that come from git (pytorch3d, gsplat, MoGe, utils3d) are pinned to commits
# in the Dockerfile; their own dependencies are listed here.

torch==2.5.1+cu121
torchvision==0.20.1+cu121

# SAM 3D Objects
hydra-core==1.3.2
omegaconf
loguru==0.7.2
lightning==2.3.3
