# Copy to .env and paste your key. One key covers every text model and Jev.
OPENROUTER_API_KEY=

# Optional, for 3D shots (docs/staging.md): where Blender is, if not on the path, and free
# keys that let `content staging find` search more model collections.
# BLENDER=/Applications/Blender.app/Contents/MacOS/Blender
# SKETCHFAB_API_TOKEN=
# POLY_PIZZA_API_KEY=
# SMITHSONIAN_API_KEY=

# Optional, SAM 3D on a cloud GPU (cloud/sam3d/README.md): printed by cloud/sam3d/setup.sh.
# SAM3D_PROJECT=
# SAM3D_REGION=
# SAM3D_BUCKET=
